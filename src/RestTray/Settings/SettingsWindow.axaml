<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="RestTray.Settings.SettingsWindow"
             Width="420" SizeToContent="Height"
             CanResize="False"
             Title="RestTray 设置"
             WindowStartupLocation="CenterScreen">

  <StackPanel Margin="20" Spacing="14">

    <TextBlock Text="提醒设置" FontSize="16" FontWeight="SemiBold" />

    <!-- 休息提醒间隔 -->
    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto">
      <TextBlock Text="休息提醒间隔(分钟)" VerticalAlignment="Center" />
      <atom:NumericUpDown x:Name="RestIntervalInput" Grid.Column="1"
                          Minimum="1" Maximum="240" HorizontalAlignment="Stretch" />
    </Grid>

    <!-- 空闲阈值 -->
    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto">
      <TextBlock Text="离开判定(分钟)" VerticalAlignment="Center"
                 ToolTip.Tip="无键鼠输入超过该时长则暂停计时(不清零)" />
      <atom:NumericUpDown x:Name="IdleThresholdInput" Grid.Column="1"
                          Minimum="1" Maximum="60" HorizontalAlignment="Stretch" />
    </Grid>

    <!-- 长休息阈值 -->
    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto">
      <TextBlock Text="已休息判定(分钟)" VerticalAlignment="Center"
                 ToolTip.Tip="无键鼠输入超过该时长视为已休息,计时清零" />
      <atom:NumericUpDown x:Name="LongBreakInput" Grid.Column="1"
                          Minimum="1" Maximum="120" HorizontalAlignment="Stretch" />
    </Grid>

    <!-- 睡觉时间 -->
    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto">
      <TextBlock Text="睡觉提醒时间" VerticalAlignment="Center" />
      <atom:LineEdit x:Name="SleepTimeInput" Grid.Column="1"
                     PlaceholderText="HH:mm,例如 23:30" HorizontalAlignment="Stretch" />
    </Grid>

    <!-- 催睡升级间隔 -->
    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto">
      <TextBlock Text="催睡升级间隔(分钟)" VerticalAlignment="Center" />
      <atom:NumericUpDown x:Name="EscalationIntervalInput" Grid.Column="1"
                          Minimum="1" Maximum="60" HorizontalAlignment="Stretch" />
    </Grid>

    <TextBlock Text="保存后立即生效,同时写入配置文件。"
               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <atom:Button x:Name="CancelButton" Content="取消" />
      <atom:Button x:Name="SaveButton" Content="保存" ButtonType="Primary" />
    </StackPanel>

  </StackPanel>
</atom:Window>
