<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0:Linux/macOS 构建;net10.0-windows:Windows 构建(GetLastInputInfo/Toast 以条件编译隔离在其中) -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 允许在非 Windows 机器上编译 net10.0-windows 目标(交叉编译验证) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'">app.manifest</ApplicationManifest>
    <RootNamespace>RestTray</RootNamespace>
    <AssemblyName>RestTray</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <ProjectReference Include="..\RestTray.Core\RestTray.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <!-- AtomUI:Ant Design 风格控件库,托盘以外的窗口控件统一使用 -->
    <PackageReference Include="AtomUI.Desktop.Controls" Version="6.2.13" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
    <!-- Windows Toast 通知,仅 Windows 目标引用 -->
    <PackageReference Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'"
                      Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- 提升 Toolkit 间接引入的 System.Drawing.Common 4.7.0(存在已知漏洞公告),仅影响 Windows 构建 -->
    <PackageReference Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'"
                      Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
