<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Avalonia.Headless.XUnit 12.x 基于 xunit v3(自执行测试程序集),需要 Exe 入口 -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 src/RestTray 的 Avalonia 12.1.6 对齐;Headless 提供无显示环境下基于 Skia 的真实渲染 -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 多目标(net10.0;net10.0-windows)中自动选取 net10.0 -->
    <ProjectReference Include="..\..\src\RestTray\RestTray.csproj" />
  </ItemGroup>

</Project>
